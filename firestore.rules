rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: burraco_games
    // Document ID: {gameId} (must match data.id)
    // Fields:
    //   - id: string (required, 3-100 chars, immutable) - Unique game identifier
    //   - createdAt: string | timestamp (optional, max 50 chars if string, immutable)
    //   - mode: string (required, 'pairs' | 'singles' | 'trio', max 20 chars) - Match mode
    //   - allowSemipulito: bool (required) - Whether semipulito burraco is counted
    //   - targetScore: number (required, 100..10000) - Winning point threshold
    //   - team1: map (required, keys: ['name', 'players'])
    //       - name: string (1-100 chars)
    //       - players: list of strings (0-4 players, 1-100 chars each)
    //   - team2: map (required, keys: ['name', 'players'])
    //       - name: string (1-100 chars)
    //       - players: list of strings (0-4 players, 1-100 chars each)
    //   - team3: map (optional for pairs/singles, required for trio, keys: ['name', 'players'])
    //       - name: string (1-100 chars)
    //       - players: list of strings (0-4 players, 1-100 chars each)
    //   - rounds: list (required, max 100 rounds) - Match rounds history
    //   - winner: string | null (optional, 'team1' | 'team2' | 'team3' | null)
    //   - isFinished: bool (required) - Whether the match has concluded
    //   - completedAt: string | timestamp (optional, max 50 chars if string)
    //   - updatedAt: timestamp | string (optional) - Server sync timestamp
    //   - ownerUid: string | null (optional, max 128 chars)
    //   - ownerEmail: string | null (optional, max 150 chars)
    //   - ownerName: string | null (optional, max 100 chars)
    //   - playerUids: list of strings (optional, max 10 items)
    //   - playerEmails: list of strings (optional, max 10 items)
    //
    // Collection: burraco_meta
    // Document ID: {docId} (e.g., 'players')
    // Fields for 'players':
    //   - list: list of strings (required, max 200 players)
    //   - updatedAt: timestamp | string (optional)
    //
    // Collection: burraco_tournaments
    // Document ID: {tournamentId} (must match data.id)
    // Fields:
    //   - id: string (required, immutable) - Unique tournament identifier
    //   - name: string (required, 1-100 chars) - Tournament name
    //   - createdAt: string | timestamp (optional, max 50 chars if string, immutable)
    //   - targetScore: number (optional, >= 100) - Target points per match
    //   - teams: list (required, 2-64 teams) - Enrolled teams
    //   - rounds: list (required, max 100 rounds) - Tournament schedule & matches
    //   - status: string (required, 'in_progress' | 'completed')
    //   - completedAt: string | timestamp (optional, max 50 chars if string)
    //   - updatedAt: string | timestamp (optional, max 50 chars if string)
    // Collection: burraco_users
    // Document ID: {userId} (must match data.uid)
    // Fields:
    //   - uid: string (required, immutable) - User Firebase Auth UID
    //   - displayName: string (required, 1-100 chars) - Player public name
    //   - email: string | null (optional, max 200 chars) - Player email
    //   - photoURL: string | null (optional, max 2048 chars)
    //   - lastLogin: string | timestamp (optional, max 50 chars if string)
    //   - lastSeen: string | timestamp (optional, max 50 chars if string)
    //   - updatedAt: string | timestamp (optional, max 50 chars if string)
    //   - guests: list (optional, max 200 items)
    //   - careerStats: map (optional, max 20 keys)
    //
    // Collection: burraco_notifications
    // Document ID: {notificationId}
    // Fields:
    //   - id: string (deterministic notification ID)
    //   - type: string ('friend_request' | 'game_invite')
    //   - fromUid: string - Sender user UID
    //   - fromName: string - Sender display name
    //   - fromEmail: string - Sender email address
    //   - toEmail: string - Target user email address
    //   - toUid: string | null - Target user UID (if registered)
    //   - status: string ('pending' | 'accepted' | 'declined')
    //
    // Collection: burraco_friends
    // Document ID: {friendshipId}
    // Fields:
    //   - id: string - Deterministic friendship ID
    //   - users: list of strings [uidA, uidB]
    //   - emails: list of strings [emailA, emailB]
    //   - user1: map (profile info of first user)
    //   - user2: map (profile info of second user)
    //   - status: string ('accepted')
    //
    // ===============================================================

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidPlayerName(name) {
      return name is string &&
             name.size() > 0 &&
             name.size() <= 100;
    }

    function isValidPlayerList(players) {
      return players is list &&
             players.size() >= 0 &&
             players.size() <= 4 &&
             (players.size() < 1 || isValidPlayerName(players[0])) &&
             (players.size() < 2 || isValidPlayerName(players[1])) &&
             (players.size() < 3 || isValidPlayerName(players[2])) &&
             (players.size() < 4 || isValidPlayerName(players[3]));
    }

    function isValidTeam(team) {
      return team is map &&
             team.keys().hasOnly(['name', 'players']) &&
             team.name is string &&
             team.name.size() > 0 &&
             team.name.size() <= 100 &&
             isValidPlayerList(team.players);
    }

    function isValidGame(data, gameId) {
      let allowedFields = [
        'id', 'createdAt', 'mode', 'allowSemipulito', 'targetScore',
        'team1', 'team2', 'team3', 'rounds', 'winner', 'isFinished', 'completedAt', 'updatedAt',
        'ownerUid', 'ownerEmail', 'ownerName', 'playerUids', 'playerEmails'
      ];
      let requiredFields = [
        'id', 'mode', 'allowSemipulito', 'targetScore', 'team1', 'team2', 'rounds', 'isFinished'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string &&
             data.id.size() >= 3 &&
             data.id.size() <= 100 &&
             data.id == gameId &&
             data.mode is string &&
             data.mode in ['pairs', 'singles', 'trio'] &&
             data.allowSemipulito is bool &&
             (data.targetScore is int || data.targetScore is float) &&
             data.targetScore >= 100 &&
             data.targetScore <= 10000 &&
             isValidTeam(data.team1) &&
             isValidTeam(data.team2) &&
             (data.mode == 'trio' ? ('team3' in data && isValidTeam(data.team3)) : (!('team3' in data) || isValidTeam(data.team3))) &&
             data.rounds is list &&
             data.rounds.size() <= 100 &&
             data.isFinished is bool &&
             (!('winner' in data) || data.winner == null || data.winner == 'team1' || data.winner == 'team2' || data.winner == 'team3') &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50) || data.completedAt is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp) &&
             (!('ownerUid' in data) || data.ownerUid == null || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
             (!('ownerEmail' in data) || data.ownerEmail == null || (data.ownerEmail is string && data.ownerEmail.size() <= 150)) &&
             (!('ownerName' in data) || data.ownerName == null || (data.ownerName is string && data.ownerName.size() <= 100)) &&
             (!('playerUids' in data) || (data.playerUids is list && data.playerUids.size() <= 10)) &&
             (!('playerEmails' in data) || (data.playerEmails is list && data.playerEmails.size() <= 10));
    }

    function isValidTournament(data, tournamentId) {
      let allowedFields = [
        'id', 'name', 'createdAt', 'targetScore', 'teams', 'rounds', 'status', 'completedAt', 'updatedAt'
      ];
      let requiredFields = [
        'id', 'name', 'teams', 'rounds', 'status'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id == tournamentId &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.status in ['in_progress', 'completed'] &&
             data.teams is list &&
             data.teams.size() >= 2 &&
             data.teams.size() <= 64 &&
             data.rounds is list &&
             data.rounds.size() <= 100 &&
             (!('targetScore' in data) || ((data.targetScore is int || data.targetScore is float) && data.targetScore >= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 50) || data.completedAt is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp);
    }

    function isValidPlayersMeta(data) {
      return data.keys().hasAll(['list']) &&
             data.keys().hasOnly(['list', 'updatedAt']) &&
             data.list is list &&
             data.list.size() <= 200 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp);
    }

    function isValidMeta(docId, data) {
      return docId == 'players'
        ? isValidPlayersMeta(data)
        : (data.keys().size() <= 20);
    }

    function isValidCareerStats(stats) {
      return stats is map &&
             stats.keys().size() <= 20 &&
             (!('totalPoints' in stats) || stats.totalPoints is int || stats.totalPoints is float) &&
             (!('gamesPlayed' in stats) || stats.gamesPlayed is int || stats.gamesPlayed is float) &&
             (!('gamesWon' in stats) || stats.gamesWon is int || stats.gamesWon is float) &&
             (!('winRate' in stats) || stats.winRate is int || stats.winRate is float) &&
             (!('cleanBurrachi' in stats) || stats.cleanBurrachi is int || stats.cleanBurrachi is float) &&
             (!('semiCleanBurrachi' in stats) || stats.semiCleanBurrachi is int || stats.semiCleanBurrachi is float) &&
             (!('dirtyBurrachi' in stats) || stats.dirtyBurrachi is int || stats.dirtyBurrachi is float) &&
             (!('closures' in stats) || stats.closures is int || stats.closures is float) &&
             (!('bestHandScore' in stats) || stats.bestHandScore is int || stats.bestHandScore is float) &&
             (!('trophiesCount' in stats) || stats.trophiesCount is int || stats.trophiesCount is float) &&
             (!('updatedAt' in stats) || (stats.updatedAt is string && stats.updatedAt.size() <= 50) || stats.updatedAt is timestamp);
    }

    function isValidUser(data, userId) {
      let allowedFields = [
        'uid', 'displayName', 'email', 'photoURL', 'lastLogin', 'lastSeen', 'updatedAt',
        'guests', 'careerStats'
      ];
      let requiredFields = [
        'uid', 'displayName'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.uid == userId &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 50) || data.lastLogin is timestamp) &&
             (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen.size() <= 50) || data.lastSeen is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp) &&
             (!('guests' in data) || (data.guests is list && data.guests.size() <= 200)) &&
             (!('careerStats' in data) || data.careerStats == null || isValidCareerStats(data.careerStats));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Matches & Round Points
    match /burraco_games/{gameId} {
      allow read: if true;
      allow create: if isValidGame(request.resource.data, gameId);
      allow update: if isValidGame(request.resource.data, gameId) &&
                       request.resource.data.id == resource.data.id &&
                       (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if true;
    }

    // Tournaments (Bracket & Round-Robin)
    match /burraco_tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isValidTournament(request.resource.data, tournamentId);
      allow update: if isValidTournament(request.resource.data, tournamentId) &&
                       request.resource.data.id == resource.data.id &&
                       (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if true;
    }

    // Global Metadata (e.g. Participants List)
    match /burraco_meta/{docId} {
      allow read: if true;
      allow create: if isValidMeta(docId, request.resource.data);
      allow update: if isValidMeta(docId, request.resource.data);
      allow delete: if true;
    }

    // Registered Users Profile / Directory
    match /burraco_users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
                       request.auth.uid == userId;
    }

    // Notifications (Friend requests & Game invitations)
    match /burraco_notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Friendships
    match /burraco_friends/{friendshipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}

