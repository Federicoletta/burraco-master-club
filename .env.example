# Configurazione Firebase Web App (Esempio)
# Copia questo file in .env e inserisci i parametri della tua console Firebase
VITE_FIREBASE_PROJECT_ID=burraco-score-fedec
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_STORAGE_BUCKET=burraco-score-fedec.firebasestorage.app
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=burraco-score-fedec.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_PROJECT_NUMBER=000000000000
