rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model (synced with firebase-blueprint.json)
    // ===============================================================
    // - burraco_games/{gameId}
    // - burraco_pins/{pin}
    // - burraco_tournaments/{tournamentId}
    // - burraco_meta/{docId}
    // - burraco_users/{userId} (Private PII - Owner only)
    // - burraco_public_profiles/{userId} (Public Club Directory - Zero PII)
    // - burraco_notifications/{notificationId}
    // - burraco_friends/{friendshipId}
    // ===============================================================

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Core Helpers
    // ===============================================================

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isVerifiedEmailMatch(emailVal) {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email_verified == true &&
             emailVal == request.auth.token.email.lower();
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlayerName(name) {
      return name is string &&
             name.size() > 0 &&
             name.size() <= 100;
    }

    function isValidPlayerList(players) {
      return players is list &&
             players.size() >= 0 &&
             players.size() <= 4 &&
             (players.size() < 1 || isValidPlayerName(players[0])) &&
             (players.size() < 2 || isValidPlayerName(players[1])) &&
             (players.size() < 3 || isValidPlayerName(players[2])) &&
             (players.size() < 4 || isValidPlayerName(players[3]));
    }

    function isValidTeam(team) {
      return team is map &&
             team.keys().hasOnly(['name', 'players', 'id']) &&
             (!('id' in team) || team.id == null || (team.id is string && team.id.size() <= 100)) &&
             team.name is string &&
             team.name.size() > 0 &&
             team.name.size() <= 100 &&
             isValidPlayerList(team.players);
    }

    function isValidGame(data, gameId) {
      let allowedFields = [
        'id', 'createdAt', 'mode', 'allowSemipulito', 'targetScore',
        'team1', 'team2', 'team3', 'rounds', 'winner', 'isFinished', 'completedAt', 'updatedAt',
        'ownerUid', 'ownerEmail', 'ownerName', 'playerUids', 'playerEmails', 'tableClosed',
        'ledgerChain', 'ledgerLastHash', 'ledgerChainLength', 'telemetry',
        'tournamentId', 'tournamentName', 'tournamentMatchId', 'tournamentRoundNumber', 'tournamentTableNumber'
      ];
      let requiredFields = [
        'id', 'mode', 'allowSemipulito', 'targetScore', 'team1', 'team2', 'rounds', 'isFinished'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string &&
             data.id.size() >= 3 &&
             data.id.size() <= 100 &&
             data.id == gameId &&
             data.mode is string &&
             data.mode in ['pairs', 'singles', 'trio'] &&
             data.allowSemipulito is bool &&
             (data.targetScore is int || data.targetScore is float) &&
             data.targetScore >= 100 &&
             data.targetScore <= 10000 &&
             isValidTeam(data.team1) &&
             isValidTeam(data.team2) &&
             (data.mode == 'trio' ? ('team3' in data && isValidTeam(data.team3)) : (!('team3' in data) || data.team3 == null || isValidTeam(data.team3))) &&
             data.rounds is list &&
             data.rounds.size() <= 100 &&
             data.isFinished is bool &&
             (!('winner' in data) || data.winner == null || data.winner == 'team1' || data.winner == 'team2' || data.winner == 'team3') &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
             (!('completedAt' in data) || data.completedAt == null || (data.completedAt is string && data.completedAt.size() <= 50) || data.completedAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp) &&
             (!('ownerUid' in data) || data.ownerUid == null || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
             (!('ownerEmail' in data) || data.ownerEmail == null || (data.ownerEmail is string && data.ownerEmail.size() <= 150)) &&
             (!('ownerName' in data) || data.ownerName == null || (data.ownerName is string && data.ownerName.size() <= 100)) &&
             (!('playerUids' in data) || (data.playerUids is list && data.playerUids.size() <= 10 && (data.playerUids.size() == 0 || data.playerUids[0] is string))) &&
             (!('playerEmails' in data) || (data.playerEmails is list && data.playerEmails.size() <= 10 && (data.playerEmails.size() == 0 || data.playerEmails[0] is string))) &&
             (!('tableClosed' in data) || data.tableClosed == null || data.tableClosed is bool) &&
             (!('ledgerChain' in data) || data.ledgerChain == null || (data.ledgerChain is list && data.ledgerChain.size() <= 200)) &&
             (!('ledgerLastHash' in data) || data.ledgerLastHash == null || (data.ledgerLastHash is string && data.ledgerLastHash.size() <= 64)) &&
             (!('ledgerChainLength' in data) || data.ledgerChainLength == null || data.ledgerChainLength is int || data.ledgerChainLength is float) &&
             (!('telemetry' in data) || data.telemetry == null || (data.telemetry is map && data.telemetry.keys().size() <= 30)) &&
             (!('tournamentId' in data) || data.tournamentId == null || (data.tournamentId is string && data.tournamentId.size() <= 100)) &&
             (!('tournamentName' in data) || data.tournamentName == null || (data.tournamentName is string && data.tournamentName.size() <= 100)) &&
             (!('tournamentMatchId' in data) || data.tournamentMatchId == null || (data.tournamentMatchId is string && data.tournamentMatchId.size() <= 100)) &&
             (!('tournamentRoundNumber' in data) || data.tournamentRoundNumber == null || data.tournamentRoundNumber is int || data.tournamentRoundNumber is float) &&
             (!('tournamentTableNumber' in data) || data.tournamentTableNumber == null || data.tournamentTableNumber is int || data.tournamentTableNumber is float);
    }

    function isValidTournament(data, tournamentId) {
      let allowedFields = [
        'id', 'name', 'createdAt', 'targetScore', 'scoringSystem', 'teams', 'rounds', 'status',
        'pausedAt', 'resumeDate', 'resumeNote', 'completedAt', 'updatedAt',
        'ownerUid', 'ownerEmail', 'ownerName'
      ];
      let requiredFields = [
        'id', 'name', 'teams', 'rounds', 'status'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string &&
             data.id.size() >= 3 &&
             data.id.size() <= 100 &&
             data.id == tournamentId &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             data.status in ['in_progress', 'paused', 'completed'] &&
             data.teams is list &&
             data.teams.size() >= 2 &&
             data.teams.size() <= 64 &&
             data.rounds is list &&
             data.rounds.size() <= 100 &&
             (!('targetScore' in data) || ((data.targetScore is int || data.targetScore is float) && data.targetScore >= 100 && data.targetScore <= 10000)) &&
             (!('scoringSystem' in data) || data.scoringSystem in ['fibur', 'classic']) &&
             (!('pausedAt' in data) || data.pausedAt == null || (data.pausedAt is string && data.pausedAt.size() <= 50) || data.pausedAt is timestamp) &&
             (!('resumeDate' in data) || data.resumeDate == null || (data.resumeDate is string && data.resumeDate.size() <= 25)) &&
             (!('resumeNote' in data) || data.resumeNote == null || (data.resumeNote is string && data.resumeNote.size() <= 240)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
             (!('completedAt' in data) || data.completedAt == null || (data.completedAt is string && data.completedAt.size() <= 50) || data.completedAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp) &&
             (!('ownerUid' in data) || data.ownerUid == null || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
             (!('ownerEmail' in data) || data.ownerEmail == null || (data.ownerEmail is string && data.ownerEmail.size() <= 150)) &&
             (!('ownerName' in data) || data.ownerName == null || (data.ownerName is string && data.ownerName.size() <= 100));
    }

    function isValidPlayersMeta(data) {
      return data.keys().hasAll(['list']) &&
             data.keys().hasOnly(['list', 'updatedAt']) &&
             data.list is list &&
             data.list.size() <= 200 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp);
    }

    function isValidMeta(docId, data) {
      return docId == 'players'
        ? isValidPlayersMeta(data)
        : (data.keys().size() <= 20);
    }

    function isValidCareerStats(stats) {
      return stats is map &&
             stats.keys().size() <= 20 &&
             (!('totalPoints' in stats) || stats.totalPoints is int || stats.totalPoints is float) &&
             (!('gamesPlayed' in stats) || stats.gamesPlayed is int || stats.gamesPlayed is float) &&
             (!('gamesWon' in stats) || stats.gamesWon is int || stats.gamesWon is float) &&
             (!('winRate' in stats) || stats.winRate is int || stats.winRate is float) &&
             (!('cleanBurrachi' in stats) || stats.cleanBurrachi is int || stats.cleanBurrachi is float) &&
             (!('semiCleanBurrachi' in stats) || stats.semiCleanBurrachi is int || stats.semiCleanBurrachi is float) &&
             (!('dirtyBurrachi' in stats) || stats.dirtyBurrachi is int || stats.dirtyBurrachi is float) &&
             (!('closures' in stats) || stats.closures is int || stats.closures is float) &&
             (!('bestHandScore' in stats) || stats.bestHandScore is int || stats.bestHandScore is float) &&
             (!('trophiesCount' in stats) || stats.trophiesCount is int || stats.trophiesCount is float) &&
             (!('updatedAt' in stats) || (stats.updatedAt is string && stats.updatedAt.size() <= 50) || stats.updatedAt is timestamp);
    }

    function isValidUser(data, userId) {
      let allowedFields = [
        'uid', 'displayName', 'email', 'photoURL', 'lastLogin', 'lastSeen', 'updatedAt',
        'guests', 'careerStats', 'closeFriends'
      ];
      let requiredFields = [
        'uid', 'displayName'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.uid is string &&
             data.uid == userId &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 50) || data.lastLogin is timestamp) &&
             (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen.size() <= 50) || data.lastSeen is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp) &&
             (!('guests' in data) || (data.guests is list && data.guests.size() <= 200)) &&
             (!('careerStats' in data) || data.careerStats == null || isValidCareerStats(data.careerStats)) &&
             (!('closeFriends' in data) || (data.closeFriends is list && data.closeFriends.size() <= 200 && (data.closeFriends.size() == 0 || data.closeFriends[0] is string)));
    }

    function isValidPublicProfile(data, userId) {
      let allowedFields = [
        'uid', 'displayName', 'displayNameLower', 'photoURL', 'lastSeen', 'updatedAt', 'careerStats'
      ];
      let requiredFields = [
        'uid', 'displayName'
      ];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.uid is string &&
             data.uid == userId &&
             data.displayName is string &&
             data.displayName.size() > 0 &&
             data.displayName.size() <= 100 &&
             (!('displayNameLower' in data) || data.displayNameLower == null || (data.displayNameLower is string && data.displayNameLower.size() <= 100)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('lastSeen' in data) || (data.lastSeen is string && data.lastSeen.size() <= 50) || data.lastSeen is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp) &&
             (!('careerStats' in data) || data.careerStats == null || isValidCareerStats(data.careerStats));
    }

    function isValidPinDoc(data, pin) {
      let allowedFields = ['pin', 'gameId', 'createdAt', 'updatedAt'];
      let requiredFields = ['pin', 'gameId'];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.pin == pin &&
             data.pin is string &&
             data.pin.size() >= 4 &&
             data.pin.size() <= 10 &&
             data.gameId is string &&
             data.gameId.size() >= 3 &&
             data.gameId.size() <= 100 &&
             isValidId(data.gameId) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp);
    }

    function isValidNotification(data, notificationId) {
      let allowedFields = [
        'id', 'type', 'gameId', 'gameName', 'teamName',
        'fromUid', 'fromName', 'fromEmail', 'fromPhoto',
        'toEmail', 'toUid', 'toName', 'toPhoto',
        'status', 'createdAt', 'acceptedAt', 'declinedAt', 'respondedAt'
      ];
      let requiredFields = ['id', 'type', 'fromUid', 'status'];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string &&
             data.id == notificationId &&
             data.id.size() >= 3 &&
             data.id.size() <= 128 &&
             data.type is string &&
             data.type in ['friend_request', 'game_invite'] &&
             data.fromUid is string &&
             data.fromUid.size() >= 1 &&
             data.fromUid.size() <= 128 &&
             data.status is string &&
             data.status in ['pending', 'accepted', 'declined'] &&
             (!('gameId' in data) || data.gameId == null || (data.gameId is string && data.gameId.size() <= 100)) &&
             (!('gameName' in data) || data.gameName == null || (data.gameName is string && data.gameName.size() <= 120)) &&
             (!('teamName' in data) || data.teamName == null || (data.teamName is string && data.teamName.size() <= 100)) &&
             (!('fromName' in data) || data.fromName == null || (data.fromName is string && data.fromName.size() <= 100)) &&
             (!('fromEmail' in data) || data.fromEmail == null || (data.fromEmail is string && data.fromEmail.size() <= 200)) &&
             (!('fromPhoto' in data) || data.fromPhoto == null || (data.fromPhoto is string && data.fromPhoto.size() <= 2048)) &&
             (!('toEmail' in data) || data.toEmail == null || (data.toEmail is string && data.toEmail.size() <= 200)) &&
             (!('toUid' in data) || data.toUid == null || (data.toUid is string && data.toUid.size() <= 128)) &&
             (!('toName' in data) || data.toName == null || (data.toName is string && data.toName.size() <= 100)) &&
             (!('toPhoto' in data) || data.toPhoto == null || (data.toPhoto is string && data.toPhoto.size() <= 2048)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
             (!('acceptedAt' in data) || (data.acceptedAt is string && data.acceptedAt.size() <= 50) || data.acceptedAt is timestamp) &&
             (!('declinedAt' in data) || (data.declinedAt is string && data.declinedAt.size() <= 50) || data.declinedAt is timestamp) &&
             (!('respondedAt' in data) || (data.respondedAt is string && data.respondedAt.size() <= 50) || data.respondedAt is timestamp);
    }

    function isValidFriendMemberMap(member) {
      return member is map &&
             member.keys().hasAll(['uid']) &&
             member.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL']) &&
             member.uid is string &&
             member.uid.size() >= 1 &&
             member.uid.size() <= 128 &&
             (!('displayName' in member) || member.displayName == null || (member.displayName is string && member.displayName.size() <= 100)) &&
             (!('email' in member) || member.email == null || (member.email is string && member.email.size() <= 200)) &&
             (!('photoURL' in member) || member.photoURL == null || (member.photoURL is string && member.photoURL.size() <= 2048));
    }

    function isValidFriendship(data, friendshipId) {
      let allowedFields = ['id', 'users', 'emails', 'user1', 'user2', 'status', 'createdAt'];
      let requiredFields = ['id', 'users', 'status'];

      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.id is string &&
             data.id == friendshipId &&
             data.id.size() >= 3 &&
             data.id.size() <= 128 &&
             data.users is list &&
             data.users.size() == 2 &&
             data.users[0] is string &&
             data.users[1] is string &&
             data.users[0] != data.users[1] &&
             data.status == 'accepted' &&
             (!('emails' in data) || (data.emails is list && data.emails.size() <= 2)) &&
             (!('user1' in data) || data.user1 == null || isValidFriendMemberMap(data.user1)) &&
             (!('user2' in data) || data.user2 == null || isValidFriendMemberMap(data.user2)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Matches & Round Points
    match /burraco_games/{gameId} {
      allow get: if isValidId(gameId);
      allow list: if isAuthenticated() &&
                     (resource.data.ownerUid == request.auth.uid ||
                      request.auth.uid in resource.data.playerUids);
      allow create: if isValidId(gameId) &&
                       isValidGame(incoming(), gameId) &&
                       (!('ownerUid' in incoming()) || incoming().ownerUid == null || (isAuthenticated() && incoming().ownerUid == request.auth.uid));
      allow update: if isValidId(gameId) &&
                       isValidGame(incoming(), gameId) &&
                       incoming().id == existing().id &&
                       (!('createdAt' in existing()) || existing().createdAt == null || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
                       ((!('ownerUid' in existing()) || existing().ownerUid == null)
                         ? (!('ownerUid' in incoming()) || incoming().ownerUid == null || (isAuthenticated() && incoming().ownerUid == request.auth.uid))
                         : incoming().ownerUid == existing().ownerUid);
      allow delete: if isAuthenticated() &&
                       isValidId(gameId) &&
                       (!('ownerUid' in existing()) || existing().ownerUid == null || existing().ownerUid == request.auth.uid);
    }

    // Fast O(1) PIN table lookups
    match /burraco_pins/{pin} {
      allow get: if isValidId(pin);
      allow list: if false;
      allow create: if isValidId(pin) &&
                       isValidPinDoc(incoming(), pin) &&
                       exists(/databases/$(database)/documents/burraco_games/$(incoming().gameId));
      allow update: if isValidId(pin) &&
                       isValidPinDoc(incoming(), pin) &&
                       incoming().gameId == existing().gameId &&
                       (!('createdAt' in existing()) || existing().createdAt == null || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt);
      allow delete: if isAuthenticated() &&
                       isValidId(pin) &&
                       (!exists(/databases/$(database)/documents/burraco_games/$(existing().gameId)) ||
                        get(/databases/$(database)/documents/burraco_games/$(existing().gameId)).data.ownerUid == null ||
                        get(/databases/$(database)/documents/burraco_games/$(existing().gameId)).data.ownerUid == request.auth.uid);
    }

    // Tournaments (Bracket & Round-Robin)
    match /burraco_tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId) &&
                    (existing().ownerUid == null || (isAuthenticated() && existing().ownerUid == request.auth.uid));
      allow list: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isValidId(tournamentId) &&
                       isValidTournament(incoming(), tournamentId) &&
                       (!('ownerUid' in incoming()) || incoming().ownerUid == null || (isAuthenticated() && incoming().ownerUid == request.auth.uid));
      allow update: if isValidId(tournamentId) &&
                       isValidTournament(incoming(), tournamentId) &&
                       incoming().id == existing().id &&
                       (!('createdAt' in existing()) || existing().createdAt == null || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt) &&
                       (!('ownerUid' in existing()) || existing().ownerUid == null || incoming().ownerUid == existing().ownerUid);
      allow delete: if isAuthenticated() &&
                       isValidId(tournamentId) &&
                       (!('ownerUid' in existing()) || existing().ownerUid == null || existing().ownerUid == request.auth.uid);
    }

    // Global Metadata
    match /burraco_meta/{docId} {
      allow get: if isAuthenticated() && isValidId(docId);
      allow list: if false;
      allow create, update: if isAuthenticated() &&
                               isValidId(docId) &&
                               isValidMeta(docId, incoming());
      allow delete: if false;
    }

    // Private User Profiles (PII isolated to owner only)
    match /burraco_users/{userId} {
      allow get: if isAuthenticated() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isAuthenticated() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUser(incoming(), userId);
      allow update: if isAuthenticated() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUser(incoming(), userId) &&
                       incoming().uid == existing().uid;
      allow delete: if isAuthenticated() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;
    }

    // Public Club Directory (Zero PII - displayName, photoURL, lastSeen, careerStats only)
    match /burraco_public_profiles/{userId} {
      allow get: if isAuthenticated() && isValidId(userId);
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidPublicProfile(incoming(), userId);
      allow update: if isAuthenticated() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidPublicProfile(incoming(), userId) &&
                       incoming().uid == existing().uid;
      allow delete: if isAuthenticated() &&
                       isValidId(userId) &&
                       request.auth.uid == userId;
    }

    // Notifications (Friend requests & Game invitations)
    match /burraco_notifications/{notificationId} {
      allow get: if isAuthenticated() &&
                    isValidId(notificationId) &&
                    (existing().fromUid == request.auth.uid ||
                     existing().toUid == request.auth.uid ||
                     isVerifiedEmailMatch(existing().toEmail));
      allow list: if isAuthenticated() &&
                     (resource.data.fromUid == request.auth.uid ||
                      resource.data.toUid == request.auth.uid ||
                      isVerifiedEmailMatch(resource.data.toEmail));
      allow create: if isAuthenticated() &&
                       isValidId(notificationId) &&
                       isValidNotification(incoming(), notificationId) &&
                       incoming().fromUid == request.auth.uid &&
                       incoming().status == 'pending';
      allow update: if isAuthenticated() &&
                       isValidId(notificationId) &&
                       isValidNotification(incoming(), notificationId) &&
                       incoming().id == existing().id &&
                       incoming().fromUid == existing().fromUid &&
                       incoming().type == existing().type &&
                       (
                         (existing().fromUid == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'toUid', 'toName', 'toPhoto', 'toEmail',
                            'createdAt', 'fromName', 'fromPhoto', 'fromEmail',
                            'gameId', 'gameName', 'teamName'
                          ])) ||
                         ((existing().toUid == request.auth.uid || isVerifiedEmailMatch(existing().toEmail)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'toUid', 'toName', 'toPhoto',
                            'acceptedAt', 'declinedAt', 'respondedAt'
                          ]))
                       );
      allow delete: if isAuthenticated() &&
                       isValidId(notificationId) &&
                       (existing().fromUid == request.auth.uid ||
                        existing().toUid == request.auth.uid ||
                        isVerifiedEmailMatch(existing().toEmail));
    }

    // Friendships
    match /burraco_friends/{friendshipId} {
      allow get: if isAuthenticated() &&
                    isValidId(friendshipId) &&
                    request.auth.uid in existing().users;
      allow list: if isAuthenticated() &&
                     request.auth.uid in resource.data.users;
      allow create: if isAuthenticated() &&
                       isValidId(friendshipId) &&
                       isValidFriendship(incoming(), friendshipId) &&
                       request.auth.uid in incoming().users;
      allow update: if isAuthenticated() &&
                       isValidId(friendshipId) &&
                       isValidFriendship(incoming(), friendshipId) &&
                       incoming().id == existing().id &&
                       (existing().users is list && request.auth.uid in existing().users) &&
                       request.auth.uid in incoming().users;
      allow delete: if isAuthenticated() &&
                       isValidId(friendshipId) &&
                       (existing().users is list && request.auth.uid in existing().users);
    }
  }
}
